# LLM API keys — set whichever your agent_model needs
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Terminal-Bench sandbox provider (set one)
E2B_API_KEY=
DAYTONA_API_KEY=
# Modal (alternative to the token pair: run `modal token new` instead)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Agent optimization HTTP service (compose.service.yaml)
# Generate a local bootstrap token with: python -m service.init_env
BOOTSTRAP_TOKEN=
OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-4.1-mini
OPTIMIZER_MODEL=gpt-4.1-mini
SANDBOX_PROVIDER=docker
# Change before the first database initialization if needed.
POSTGRES_PASSWORD=local-development-only

